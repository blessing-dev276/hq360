# --- Site ---------------------------------------------------------------------
# Public site URL, used for canonical + Open Graph absolute URLs.
SITE_URL=https://hq360.lovable.app
VITE_SITE_URL=https://hq360.lovable.app

# --- Supabase (provided by Lovable Cloud) ------------------------------------
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never exposed to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Transactional email (optional) ----------------------------------------
# Leave unset to run without email: leads are still stored and downloads still work.
EMAIL_PROVIDER=            # "resend" to enable
RESEND_API_KEY=
EMAIL_FROM=HQ360 <hello@hq360.co>

# --- Lead forwarding / CRM webhook (optional) -----------------------------
# Point at GoHighLevel inbound webhook, HubSpot, Zapier, Make, or any endpoint.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=            # sent as X-HQ360-Signature, optional
LEAD_WEBHOOK_AUTH_HEADER=       # e.g. Authorization
LEAD_WEBHOOK_AUTH_VALUE=        # e.g. "Bearer xxxxx"

# --- Admin page (/admin) --------------------------------------------------
# Shared passphrase for the internal portfolio manager. Min 6 chars.
# Not multi-user auth — one team secret. Uploads also need SUPABASE_SERVICE_ROLE_KEY.
ADMIN_PASSWORD=

# --- Author Scout Academy (/academy) ---------------------------------------
# No AI and no API keys: the demo author is the rule based Author Engine.
# It only needs the Supabase variables above.
