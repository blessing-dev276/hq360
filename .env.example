# --- Site ---------------------------------------------------------------------
# Public site URL, used for canonical + Open Graph absolute URLs.
SITE_URL=https://www.hq360.space
VITE_SITE_URL=https://www.hq360.space

# --- Supabase --------------------------------------------------------------
# Set these in your host's environment/secrets for deployed builds. The VITE_*
# copies are inlined into the client bundle at build time, so they must be
# present when you build, not just at runtime.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never exposed to the client bundle. Powers /admin DB + storage.
SUPABASE_SERVICE_ROLE_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Transactional email (optional) ----------------------------------------
# Leave unset to run without email: leads are still stored and downloads still work.
EMAIL_PROVIDER=resend      # "resend" to enable
RESEND_API_KEY=
EMAIL_FROM="HQ360 <ceo@hq360.space>"
LEAD_EMAIL=ceo@hq360.space

# --- Lead forwarding / CRM webhook (optional) -----------------------------
# Point at GoHighLevel inbound webhook, HubSpot, Zapier, Make, or any endpoint.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=            # sent as X-HQ360-Signature, optional
LEAD_WEBHOOK_AUTH_HEADER=       # e.g. Authorization
LEAD_WEBHOOK_AUTH_VALUE=        # e.g. "Bearer xxxxx"

# --- Admin page (/admin) --------------------------------------------------
# Server-only admin credentials. Use a long, unique password.
# ADMIN_USERNAME defaults to "admin" when omitted.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Server-only ElevenLabs speech-to-text key for visitor voice enquiries.
ELEVENLABS_API_KEY=

# Optional Google Books project key for public catalog quota. Server-only.
GOOGLE_BOOKS_API_KEY=
